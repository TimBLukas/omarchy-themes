# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#8cff8c"

# Title color for boxes
theme[title]="#8cff8c"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#66ff66"

# Background color of selected item in processes box
theme[selected_bg]="#123d1a"

# Foreground color of selected item in processes box
theme[selected_fg]="#a0ffa0"

# Color of inactive/disabled text
theme[inactive_fg]="#3c8f4c"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#72e878"

# Background color of the percentage meters
theme[meter_bg]=""


# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#58d866"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#66ff66"
theme[mem_box]="#a0ffa0"
theme[net_box]="#4bbf59"
theme[proc_box]="#72e878"

# Box divider line and small boxes line color
theme[div_line]="#2a6b36"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#4bbf59"
theme[temp_mid]="#72e878"
theme[temp_end]="#a0ffa0"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="#3c8f4c"
theme[cpu_mid]="#66ff66"
theme[cpu_end]="#a0ffa0"

# Mem/Disk free meter (Mauve -> Lavender -> Blue)
theme[free_start]="#347f40"
theme[free_mid]="#66ff66"
theme[free_end]="#a0ffa0"

# Mem/Disk cached meter (Sapphire -> Lavender)
theme[cached_start]="#3c8f4c"
theme[cached_mid]="#72e878"
theme[cached_end]="#a0ffa0"

# Mem/Disk available meter (Peach -> Red)
theme[available_start]="#4bbf59"
theme[available_mid]="#72e878"
theme[available_end]="#a0ffa0"

# Mem/Disk used meter (Green -> Sky)
theme[used_start]="#4bbf59"
theme[used_mid]="#66ff66"
theme[used_end]="#a0ffa0"

# Download graph colors (Peach -> Red)
theme[download_start]="#4bbf59"
theme[download_mid]="#72e878"
theme[download_end]="#a0ffa0"

# Upload graph colors (Green -> Sky)
theme[upload_start]="#4bbf59"
theme[upload_mid]="#66ff66"
theme[upload_end]="#a0ffa0"

# Process box color gradient for threads, mem and cpu usage (Sapphire -> Mauve)
theme[process_start]="#3c8f4c"
theme[process_mid]="#66ff66"
theme[process_end]="#a0ffa0"
